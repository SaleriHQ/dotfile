layout {
    gaps 8
    focus-ring {
        width 4
        active-gradient from="22c55e" to="3b82f6" angle=60
        inactive-color "#111415"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#64d3ff"
        inactive-color "#111415"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#64d3ff"
        inactive-color "#004d63"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#64d3ff80"
    }
}

recent-windows {
    highlight {
        active-color "#64d3ff"
        urgent-color "#ffb4ab"
    }
}
